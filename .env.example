# Server
APP_NAME=Universal Model Server
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=1

# SLA
SLA_URGENT_MS=100
SLA_NORMAL_MS=500
SLA_BATCH_MS=5000

# Queue
MAX_QUEUE_SIZE=1000

# Device
DEFAULT_DEVICE=cpu

# Observability
ENABLE_TRACING=true
PROMETHEUS_PORT=9090

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Auth
API_KEY_ENABLED=false
API_KEYS=your-secret-key-here

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me